{
  "name": "@zkpay/sdk-solana",
  "version": "0.1.0",
  "description": "TypeScript SDK for zkPay private SOL payments on Solana Mainnet",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "repository": { "type": "git", "url": "git+https://github.com/zkPayonSOL/zkpay-sdk-solana.git" },
  "homepage": "https://docs.zkpay.sh/",
  "bugs": { "url": "https://github.com/zkPayonSOL/zkpay-sdk-solana/issues" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./package.json": "./package.json" },
  "files": ["dist", "README.md", "SECURITY.md", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "artifacts:download": "npm run build && node scripts/download-artifacts.mjs",
    "test:proof": "tsx --test test/proving/real-proof.test.ts test/proving/roundtrip.test.ts",
    "test:live-readonly": "ZKPAY_LIVE_READONLY=1 tsx --test test/integration/live-readonly.test.ts",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@lightprotocol/hasher.rs": "0.2.1",
    "@noble/hashes": "1.8.0",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5",
    "borsh": "2.0.0",
    "bs58": "5.0.0",
    "buffer": "6.0.3",
    "snarkjs": "0.7.6",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "22.20.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@solana/web3.js": { "jayson": "5.0.0" },
    "jsonpath@1.3.0": { "underscore": "1.13.8" }
  }
}
